# /etc/systemd/system/infogen.service on the instance: pull the current image and start the container at every boot.
[Unit]
Description=infogen container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/infogen
# Docker creates a missing working directory (/data/runs) as root on the bind mount; create it first, owned by the container user
ExecStartPre=/bin/bash -c 'mkdir -p /data/infogen/data/runs /data/infogen/data/claude /data/infogen/home && chown 1000:1000 /data/infogen/data /data/infogen/data/runs /data/infogen/data/claude /data/infogen/home'
ExecStartPre=-/opt/infogen/fetch-env.sh
ExecStartPre=/bin/bash -c 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin $(grep ^INFOGEN_IMAGE_URI= .env | cut -d= -f2 | cut -d/ -f1)'
ExecStartPre=-/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
[Install]
WantedBy=multi-user.target
